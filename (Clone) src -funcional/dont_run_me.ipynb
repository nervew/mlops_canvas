    "import time\n",
    "horas= float(input(\"cuantas horas quiere que la maquina este prendida\"))\n",
    "minutos =int(horas*60)\n",
    "for i in range(minutos // 15):\n",
    "    print(f\"Esperando... minuto{i*15}\")\n",
    "    time.sleep(15*60)\n",
    "print(\"Tiempo completado\")"
